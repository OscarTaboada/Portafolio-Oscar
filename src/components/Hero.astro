---
import { personalData } from '../data/portfolio';
---

<section id="inicio" class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <!-- Subtle background ambient grid -->
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:32px_32px] opacity-[0.03] dark:opacity-[0.07]"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col-reverse md:flex-row items-center justify-between gap-10 md:gap-16">
      
      <!-- Left Content Column -->
      <div class="flex-1 text-center md:text-left reveal-on-scroll">
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-sky-500/10 dark:bg-sky-400/10 border border-sky-500/20 text-sky-700 dark:text-sky-300 text-xs font-semibold mb-6 tracking-wide shadow-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>{personalData.statusText}</span>
        </div>

        <!-- Name & Title -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.12]">
          Hola, soy <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-blue-400 to-indigo-400">{personalData.name}</span>
        </h1>

        <p class="mt-4 text-xl sm:text-2xl font-semibold text-slate-700 dark:text-slate-300">
          {personalData.fullTitle}
        </p>

        <!-- Location & Tagline -->
        <div class="mt-3 flex items-center justify-center md:justify-start gap-2 text-sm text-slate-500 dark:text-slate-400">
          <svg class="w-4 h-4 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{personalData.location}</span>
          <span class="text-slate-400 dark:text-slate-600">•</span>
          <span>Unity C# · Motion Graphics · Audiovisual</span>
        </div>

        <p class="mt-6 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
          {personalData.bioHeadline} Especializado en videojuegos educativos con Unity, edición de video de alto impacto para eventos tecnológicos y diseño visual enfocado en resultados.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center justify-center md:justify-start gap-3.5">
          <a
            href="#proyectos"
            class="px-6 py-3 rounded-xl bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-semibold text-sm shadow-lg shadow-sky-500/20 hover:shadow-sky-500/35 transition-all duration-300 flex items-center gap-2 group"
          >
            <span>Explorar Proyectos</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href={personalData.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3 rounded-xl bg-slate-100 dark:bg-slate-800/90 hover:bg-slate-200 dark:hover:bg-slate-700/80 text-slate-800 dark:text-slate-200 font-semibold text-sm border border-slate-300/60 dark:border-slate-700 transition-all duration-200 flex items-center gap-2"
          >
            <!-- WhatsApp icon -->
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.54 1.772.84 2.796.84 3.183 0 5.768-2.587 5.768-5.766.001-3.187-2.575-5.77-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.073-2.18-.544-1.899-.787-3.119-2.73-3.214-2.857-.095-.128-.767-1.021-.767-1.947 0-.926.485-1.381.658-1.57.172-.189.376-.236.502-.236.126 0 .252.001.363.007.118.006.275-.045.431.33.161.387.551 1.343.6 1.442.049.099.082.215.016.345-.066.13-.1.21-.198.324-.098.114-.207.255-.296.342-.099.097-.202.203-.087.401.115.197.512.845 1.1 1.368.756.674 1.393.882 1.591.98.198.099.314.083.43-.05.116-.132.497-.578.63-.775.132-.198.265-.165.447-.099.182.066 1.155.545 1.353.644.198.099.33.148.379.231.049.083.049.479-.095.884z"/>
            </svg>
            <span>WhatsApp</span>
          </a>

          <a
            href="#contacto"
            class="px-5 py-3 rounded-xl hover:text-sky-600 dark:hover:text-sky-400 text-slate-600 dark:text-slate-400 font-semibold text-sm transition-colors duration-200"
          >
            Contactar vía email
          </a>
        </div>

        <!-- Pillars preview -->
        <div class="mt-10 pt-8 border-t border-slate-200/60 dark:border-slate-800/60 grid grid-cols-3 gap-4 text-center md:text-left">
          <div>
            <div class="text-2xl font-black text-sky-500 dark:text-sky-400">6+</div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Proyectos Clave</div>
          </div>
          <div>
            <div class="text-2xl font-black text-blue-500 dark:text-blue-400">Unity</div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">C# & Play Store</div>
          </div>
          <div>
            <div class="text-2xl font-black text-indigo-500 dark:text-indigo-400">GDG</div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Audiovisual Sucre</div>
          </div>
        </div>
      </div>

      <!-- Right Image Column (Oscar's photo) -->
      <div class="w-full max-w-sm sm:max-w-md md:w-80 lg:w-96 shrink-0 reveal-on-scroll">
        <div class="relative mx-auto aspect-square max-w-[320px] lg:max-w-[360px]">
          <!-- Decorative rings & glows -->
          <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-sky-500/20 via-blue-500/10 to-transparent blur-xl"></div>
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-tr from-sky-400/20 to-blue-600/20 border border-sky-400/30 -rotate-3 transition-transform duration-500 group-hover:rotate-0"></div>

          <!-- Image container -->
          <div class="relative h-full w-full rounded-2xl overflow-hidden bg-slate-900 border border-slate-800/80 shadow-2xl">
            <img
              src={personalData.avatarUrl}
              alt="Foto de Oscar Taboada"
              class="w-full h-full object-cover object-center filter contrast-[1.02] brightness-[0.98] hover:scale-105 transition-transform duration-500"
              loading="eager"
            />
            
            <!-- Bottom glass info chip -->
            <div class="absolute bottom-3 inset-x-3 p-3 rounded-xl bg-slate-950/70 dark:bg-slate-900/80 backdrop-blur-md border border-white/10 text-xs flex items-center justify-between">
              <div>
                <span class="block font-semibold text-white">Oscar Taboada</span>
                <span class="text-sky-400 text-[11px]">Sucre, Bolivia</span>
              </div>
              <span class="px-2 py-0.5 rounded-md bg-sky-500/20 text-sky-300 font-mono text-[10px]">USFX</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
