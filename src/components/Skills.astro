---
import { skillCategories, allToolsList } from '../data/portfolio';
---

<section id="habilidades" class="py-20 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="max-w-2xl mx-auto text-center mb-16 reveal-on-scroll">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400 text-xs font-semibold mb-3">
        <span>Competencias Técnicas</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Habilidades & Herramientas
      </h2>
      <p class="mt-3 text-slate-600 dark:text-slate-400 text-sm sm:text-base">
        Una combinación de desarrollo de software para videojuegos, dominio de software de diseño y postproducción audiovisual profesional.
      </p>
      <div class="w-12 h-1 bg-gradient-to-r from-sky-400 to-blue-600 mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- 3 Pillars Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {skillCategories.map((cat, idx) => (
        <div class="p-7 rounded-2xl bg-white dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 hover:border-sky-500/40 dark:hover:border-sky-400/40 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col justify-between reveal-on-scroll group">
          <div>
            <!-- Icon & Number -->
            <div class="flex items-center justify-between mb-5">
              <div class="w-12 h-12 rounded-xl bg-sky-500/10 dark:bg-sky-400/10 text-sky-600 dark:text-sky-400 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                {cat.icon === 'gamepad' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                  </svg>
                )}
                {cat.icon === 'video' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                )}
                {cat.icon === 'palette' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4 5 5 0 015-5h4a2 2 0 002-2 3 3 0 013-3 2 2 0 012 2v1a5 5 0 01-5 5h-1a2 2 0 00-2 2 3 3 0 01-3 3z" />
                  </svg>
                )}
              </div>
              <span class="text-xs font-mono font-bold text-slate-400 dark:text-slate-500">0{idx + 1}</span>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
              {cat.title}
            </h3>

            <p class="text-xs text-slate-500 dark:text-slate-400 mb-5 leading-relaxed">
              {cat.description}
            </p>

            <!-- Skills Bullet Points -->
            <ul class="space-y-2 mb-6">
              {cat.skills.map((skill) => (
                <li class="flex items-start gap-2 text-xs text-slate-700 dark:text-slate-300">
                  <svg class="w-4 h-4 text-sky-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tools Chips -->
          <div class="pt-4 border-t border-slate-100 dark:border-slate-700/60 flex flex-wrap gap-1.5">
            {cat.tools.map((t) => (
              <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-700/50 text-[11px] font-medium text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-600/50">
                {t.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- All Programs Grid Bar -->
    <div class="p-8 rounded-2xl bg-slate-50 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 reveal-on-scroll">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Stack de Software & Programas</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Herramientas que utilizo en mi flujo diario de producción y desarrollo.</p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400 w-fit">
          11 Herramientas Principales
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {allToolsList.map((tool) => (
          <div class="p-3 rounded-xl bg-white dark:bg-slate-800/70 border border-slate-200/70 dark:border-slate-700/50 hover:border-sky-400/50 text-center transition-all duration-200 group">
            <span class="block text-xs font-bold text-slate-800 dark:text-slate-200 group-hover:text-sky-500 transition-colors">
              {tool.name}
            </span>
            <span class="block text-[10px] text-slate-500 dark:text-slate-400 mt-1">
              {tool.category}
            </span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
