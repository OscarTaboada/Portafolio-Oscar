---
import { personalData } from '../data/portfolio';
---

<section id="sobre-mi" class="py-20 bg-slate-50/50 dark:bg-slate-900/30 border-y border-slate-200/40 dark:border-slate-800/60 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="max-w-2xl mx-auto text-center mb-16 reveal-on-scroll">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400 text-xs font-semibold mb-3">
        <span>Trayectoria & Filosofía</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Sobre mí
      </h2>
      <div class="w-12 h-1 bg-gradient-to-r from-sky-400 to-blue-600 mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Biography Narrative -->
      <div class="lg:col-span-7 space-y-6 text-slate-600 dark:text-slate-300 leading-relaxed reveal-on-scroll">
        <p class="text-lg font-medium text-slate-800 dark:text-slate-200">
          {personalData.bioLead}
        </p>

        <p>
          {personalData.bioDescription}
        </p>

        <!-- 3 Pillars Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4">
          <div class="p-4 rounded-xl bg-white dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 shadow-xs">
            <div class="w-8 h-8 rounded-lg bg-sky-500/10 text-sky-500 flex items-center justify-center font-bold text-sm mb-2.5">
              01
            </div>
            <h4 class="font-bold text-slate-900 dark:text-white text-sm">Detalle & Calidad</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Cuidado minucioso en cada frame, pixel y línea de código.</p>
          </div>

          <div class="p-4 rounded-xl bg-white dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 shadow-xs">
            <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center font-bold text-sm mb-2.5">
              02
            </div>
            <h4 class="font-bold text-slate-900 dark:text-white text-sm">Adaptabilidad</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Integración fluida en equipos multidisciplinarios y metodologías ágiles.</p>
          </div>

          <div class="p-4 rounded-xl bg-white dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 shadow-xs">
            <div class="w-8 h-8 rounded-lg bg-indigo-500/10 text-indigo-500 flex items-center justify-center font-bold text-sm mb-2.5">
              03
            </div>
            <h4 class="font-bold text-slate-900 dark:text-white text-sm">Orientado a Fin</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Soluciones creativas alineadas a métricas reales y metas del cliente.</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Education & Experience Card -->
      <div class="lg:col-span-5 space-y-6 reveal-on-scroll">
        <!-- Education Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800/70 border border-slate-200/80 dark:border-slate-700/80 shadow-md">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 dark:bg-sky-400/10 text-sky-600 dark:text-sky-400 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path d="M12 14l9-5-9-5-9 5 9 5z" />
                <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-base">Formación Académica</h3>
              <span class="text-xs text-sky-600 dark:text-sky-400 font-medium">Grado Universitario</span>
            </div>
          </div>

          <div class="space-y-2 border-l-2 border-sky-400/40 pl-4 ml-2">
            <div class="text-sm font-bold text-slate-900 dark:text-white">
              {personalData.education.degree}
            </div>
            <div class="text-xs font-semibold text-sky-600 dark:text-sky-400">
              {personalData.education.institution}
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400">
              {personalData.education.period} • {personalData.education.location}
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-300 pt-2 leading-relaxed">
              {personalData.education.details}
            </p>
          </div>
        </div>

        <!-- Community Leadership Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800/70 border border-slate-200/80 dark:border-slate-700/80 shadow-md">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-base">Comunidad & Liderazgo</h3>
              <span class="text-xs text-blue-600 dark:text-blue-400 font-medium">Google Developer Groups</span>
            </div>
          </div>

          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Coordinador audiovisual activo en los eventos de <strong>GDG Sucre</strong> (Google I/O Extended y DevFest Sucre), impulsando la cultura tecnológica de la región mediante cobertura en vivo y contenidos audiovisuales dinámicos.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
