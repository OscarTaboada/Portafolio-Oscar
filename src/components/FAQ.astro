---
import { faqItems } from '../data/portfolio';
---

<section id="faq" class="py-20 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center mb-16 reveal-on-scroll">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400 text-xs font-semibold mb-3">
        <span>Resolviendo Dudas</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Preguntas Frecuentes
      </h2>
      <p class="mt-3 text-slate-600 dark:text-slate-400 text-sm sm:text-base">
        Información clara sobre modalidades de trabajo, servicios y cómo podemos colaborar.
      </p>
      <div class="w-12 h-1 bg-gradient-to-r from-sky-400 to-blue-600 mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- FAQ Accordion List -->
    <div class="space-y-4">
      {faqItems.map((item, idx) => (
        <details class="group p-6 rounded-2xl bg-white dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 shadow-xs hover:border-sky-400/40 transition-all duration-200 reveal-on-scroll">
          <summary class="flex items-center justify-between cursor-pointer list-none font-bold text-slate-900 dark:text-white text-base sm:text-lg select-none">
            <span class="flex items-center gap-3">
              <span class="w-7 h-7 rounded-lg bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center text-xs font-bold shrink-0">
                0{idx + 1}
              </span>
              <span>{item.question}</span>
            </span>
            <span class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-700/60 text-slate-500 dark:text-slate-400 flex items-center justify-center shrink-0 ml-4 group-open:rotate-180 transition-transform duration-200">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          
          <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-700/60 text-sm text-slate-600 dark:text-slate-300 leading-relaxed whitespace-pre-line">
            {item.answer}
          </div>
        </details>
      ))}
    </div>

    <!-- Bottom Help CTA -->
    <div class="mt-12 text-center p-6 rounded-2xl bg-sky-500/5 dark:bg-sky-500/10 border border-sky-500/20 reveal-on-scroll">
      <p class="text-sm font-medium text-slate-700 dark:text-slate-300">
        ¿Tienes una consulta específica o un proyecto especial en mente?
      </p>
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 mt-3 text-xs font-bold text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300"
      >
        <span>Escríbeme directamente y conversamos</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>
</section>
