---
import { personalData } from '../data/portfolio';
---

<header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-slate-900/75 dark:bg-[#0b0f19]/80 border-b border-slate-200/20 dark:border-slate-800/60 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="#inicio" class="group flex items-center gap-2.5 font-semibold text-slate-800 dark:text-slate-100 tracking-tight">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-sky-400 to-blue-600 flex items-center justify-center text-slate-950 font-black text-sm shadow-sm group-hover:shadow-sky-500/25 group-hover:shadow-md transition-all duration-300">
        OT
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-bold text-slate-900 dark:text-white leading-tight">{personalData.name}</span>
        <span class="text-[11px] text-sky-600 dark:text-sky-400 font-medium tracking-wide">Animación & Videojuegos</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-slate-600 dark:text-slate-300">
      <a href="#inicio" class="px-3 py-1.5 rounded-lg hover:text-sky-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
        Inicio
      </a>
      <a href="#sobre-mi" class="px-3 py-1.5 rounded-lg hover:text-sky-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
        Sobre mí
      </a>
      <a href="#habilidades" class="px-3 py-1.5 rounded-lg hover:text-sky-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
        Habilidades
      </a>
      <a href="#proyectos" class="px-3 py-1.5 rounded-lg hover:text-sky-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
        Proyectos
      </a>
      <a href="#faq" class="px-3 py-1.5 rounded-lg hover:text-sky-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
        FAQ
      </a>
      <a href="#contacto" class="px-3 py-1.5 rounded-lg hover:text-sky-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
        Contacto
      </a>
    </nav>

    <!-- Actions: CV button + Theme Toggle + Mobile Toggle -->
    <div class="flex items-center gap-2.5">
      <!-- CV Download Button -->
      <a
        href="#contacto"
        class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 border border-slate-300/60 dark:border-slate-700 transition-all duration-200 shadow-sm"
        title="Descargar Curriculum Vitae"
        id="cv-download-btn"
      >
        <svg class="w-3.5 h-3.5 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>CV</span>
      </a>

      <!-- Theme Switcher Button -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Cambiar tema oscuro/claro"
        class="w-9 h-9 flex items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 hover:text-sky-500 dark:hover:text-sky-400 border border-slate-200 dark:border-slate-700/60 transition-colors duration-200"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="theme-icon-sun" class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="theme-icon-moon" class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Abrir menú"
        class="md:hidden w-9 h-9 flex items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-4 border-b border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md">
    <div class="flex flex-col space-y-1.5 text-sm font-medium">
      <a href="#inicio" class="mobile-nav-link px-3 py-2 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">Inicio</a>
      <a href="#sobre-mi" class="mobile-nav-link px-3 py-2 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">Sobre mí</a>
      <a href="#habilidades" class="mobile-nav-link px-3 py-2 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">Habilidades</a>
      <a href="#proyectos" class="mobile-nav-link px-3 py-2 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">Proyectos</a>
      <a href="#faq" class="mobile-nav-link px-3 py-2 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">Preguntas Frecuentes</a>
      <a href="#contacto" class="mobile-nav-link px-3 py-2 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">Contacto</a>
    </div>
  </div>
</header>

<script>
  // Theme toggle script
  const themeBtn = document.getElementById('theme-toggle');
  const metaColorScheme = document.getElementById('meta-color-scheme') as HTMLMetaElement | null;

  function toggleTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme-preference', 'light');
      if (metaColorScheme) metaColorScheme.content = 'light';
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme-preference', 'dark');
      if (metaColorScheme) metaColorScheme.content = 'dark';
    }
  }

  themeBtn?.addEventListener('click', toggleTheme);

  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });

  // CV download button feedback
  const cvBtn = document.getElementById('cv-download-btn');
  cvBtn?.addEventListener('click', () => {
    if ((window as any).showToast) {
      (window as any).showToast('CV disponible a través del canal de contacto directo');
    }
  });
</script>
